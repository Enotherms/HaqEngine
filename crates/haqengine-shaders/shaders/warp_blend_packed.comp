#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D prev_frame;
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D cur_frame;
layout(set = 0, binding = 2, rg32f) uniform readonly image2D flow;
layout(set = 0, binding = 3, r32ui) uniform writeonly uimage2D dst;

layout(set = 0, binding = 4, r32f) uniform readonly image2D prev_luma;
layout(set = 0, binding = 5, r32f) uniform readonly image2D cur_luma;

layout(push_constant) uniform Push {
    uint w;
    uint h;
    uint flow_w;
    uint flow_h;
    float t;
    uint format;
} pc;

const uint FULL_BLOCK = 16u;
const float QUANT = 1023.0;
const int DISAGREE = 96;

int quantize_luma(float l) {
    precise float q = clamp(l, 0.0, 1.0) * QUANT;
    precise float r = q + 0.5;
    return int(floor(r));
}

float luma_prev_at(vec2 q) {
    ivec2 size = imageSize(prev_luma);
    ivec2 c = clamp(ivec2(floor(q / 2.0)), ivec2(0), size - ivec2(1));
    return imageLoad(prev_luma, c).r;
}

float luma_cur_at(vec2 q) {
    ivec2 size = imageSize(cur_luma);
    ivec2 c = clamp(ivec2(floor(q / 2.0)), ivec2(0), size - ivec2(1));
    return imageLoad(cur_luma, c).r;
}

vec4 unpack_pixel(uint w) {
    if (pc.format == 2u) {
        return vec4(
            float(w & 1023u) / 1023.0,
            float((w >> 10u) & 1023u) / 1023.0,
            float((w >> 20u) & 1023u) / 1023.0,
            float(w >> 30u) / 3.0
        );
    }
    vec4 b = vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u)) / 255.0;
    return pc.format == 1u ? b.zyxw : b;
}

uint quantize(float c, float m) {
    precise float v = clamp(c, 0.0, 1.0) * m;
    precise float r = v + 0.5;
    return uint(floor(r));
}

uint pack_pixel(vec4 c) {
    if (pc.format == 2u) {
        return quantize(c.r, 1023.0) | (quantize(c.g, 1023.0) << 10u) | (quantize(c.b, 1023.0) << 20u)
            | (quantize(c.a, 3.0) << 30u);
    }
    vec4 o = pc.format == 1u ? c.zyxw : c;
    return quantize(o.x, 255.0) | (quantize(o.y, 255.0) << 8u) | (quantize(o.z, 255.0) << 16u)
        | (quantize(o.w, 255.0) << 24u);
}

vec4 bilinear_prev(vec2 p) {
    vec2 c = clamp(p, vec2(0.0), vec2(float(pc.w - 1u), float(pc.h - 1u)));
    ivec2 p0 = ivec2(floor(c));
    ivec2 p1 = min(p0 + ivec2(1), ivec2(int(pc.w) - 1, int(pc.h) - 1));
    vec2 f = c - vec2(p0);
    vec4 top = mix(unpack_pixel(imageLoad(prev_frame, p0).r), unpack_pixel(imageLoad(prev_frame, ivec2(p1.x, p0.y)).r), f.x);
    vec4 bottom = mix(unpack_pixel(imageLoad(prev_frame, ivec2(p0.x, p1.y)).r), unpack_pixel(imageLoad(prev_frame, p1).r), f.x);
    return mix(top, bottom, f.y);
}

vec4 bilinear_cur(vec2 p) {
    vec2 c = clamp(p, vec2(0.0), vec2(float(pc.w - 1u), float(pc.h - 1u)));
    ivec2 p0 = ivec2(floor(c));
    ivec2 p1 = min(p0 + ivec2(1), ivec2(int(pc.w) - 1, int(pc.h) - 1));
    vec2 f = c - vec2(p0);
    vec4 top = mix(unpack_pixel(imageLoad(cur_frame, p0).r), unpack_pixel(imageLoad(cur_frame, ivec2(p1.x, p0.y)).r), f.x);
    vec4 bottom = mix(unpack_pixel(imageLoad(cur_frame, ivec2(p0.x, p1.y)).r), unpack_pixel(imageLoad(cur_frame, p1).r), f.x);
    return mix(top, bottom, f.y);
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.w || p.y >= pc.h) {
        return;
    }
    ivec2 ip = ivec2(p);
    if (pc.t == 0.0) {
        imageStore(dst, ip, uvec4(imageLoad(prev_frame, ip).r, 0u, 0u, 0u));
        return;
    }
    if (pc.t == 1.0) {
        imageStore(dst, ip, uvec4(imageLoad(cur_frame, ip).r, 0u, 0u, 0u));
        return;
    }
    ivec2 block = ivec2(min(p.x / FULL_BLOCK, pc.flow_w - 1u), min(p.y / FULL_BLOCK, pc.flow_h - 1u));
    ivec2 offsets[5] = ivec2[5](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    vec2 pos = vec2(p);
    vec2 seen[5];
    int seen_count = 0;
    vec2 best_v = vec2(0.0);
    int best_cost = 0x7fffffff;
    for (int i = 0; i < 5; i++) {
        ivec2 c = block + offsets[i];
        if (c.x < 0 || c.y < 0 || c.x >= int(pc.flow_w) || c.y >= int(pc.flow_h)) {
            continue;
        }
        vec2 v = imageLoad(flow, c).rg * 2.0;
        bool duplicate = false;
        for (int j = 0; j < seen_count; j++) {
            duplicate = duplicate || seen[j] == v;
        }
        if (duplicate) {
            continue;
        }
        seen[seen_count++] = v;
        int cost = abs(quantize_luma(luma_prev_at(pos - pc.t * v)) - quantize_luma(luma_cur_at(pos + (1.0 - pc.t) * v)));
        if (cost < best_cost) {
            best_cost = cost;
            best_v = v;
        }
    }
    vec4 a = bilinear_prev(pos - pc.t * best_v);
    vec4 b = bilinear_cur(pos + (1.0 - pc.t) * best_v);
    vec4 result = best_cost > DISAGREE ? (pc.t >= 0.5 ? b : a) : mix(a, b, pc.t);
    imageStore(dst, ip, uvec4(pack_pixel(result), 0u, 0u, 0u));
}
