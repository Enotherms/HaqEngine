#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D src;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    uint in_w;
    uint in_h;
    uint format;
} pc;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

vec4 unpack_pixel(uint w) {
    if (pc.format == 2u) {
        return vec4(
            float(w & 1023u) / 1023.0,
            float((w >> 10u) & 1023u) / 1023.0,
            float((w >> 20u) & 1023u) / 1023.0,
            float(w >> 30u) / 3.0
        );
    }
    vec4 b = vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u)) / 255.0;
    return pc.format == 1u ? b.zyxw : b;
}

void main() {
    uvec2 o = gl_GlobalInvocationID.xy;
    uint out_w = (pc.in_w + 1u) / 2u;
    uint out_h = (pc.in_h + 1u) / 2u;
    if (o.x >= out_w || o.y >= out_h) {
        return;
    }
    float sum = 0.0;
    float count = 0.0;
    for (uint dy = 0u; dy < 2u; dy++) {
        for (uint dx = 0u; dx < 2u; dx++) {
            uvec2 p = o * 2u + uvec2(dx, dy);
            if (p.x < pc.in_w && p.y < pc.in_h) {
                sum += dot(unpack_pixel(imageLoad(src, ivec2(p)).r).rgb, LUMA);
                count += 1.0;
            }
        }
    }
    imageStore(dst, ivec2(o), vec4(sum / count, 0.0, 0.0, 0.0));
}
