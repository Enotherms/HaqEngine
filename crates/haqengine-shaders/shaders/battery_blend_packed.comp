#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D prev_frame;
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D cur_frame;
layout(set = 0, binding = 2, rg32f) uniform readonly image2D flow;
layout(set = 0, binding = 3, r32ui) uniform writeonly uimage2D dst;
layout(set = 0, binding = 4, r32f) uniform readonly image2D prev_luma;
layout(set = 0, binding = 5, r32f) uniform readonly image2D cur_luma;
layout(set = 0, binding = 6, r32ui) uniform uimage2D counters;
layout(set = 0, binding = 7, r32ui) uniform uimage2D tiles;

layout(push_constant) uniform Push {
    uint w;
    uint h;
    uint flow_w;
    uint flow_h;
    float t;
    uint format;
    uint row;
} pc;

const int BLOCK = 16;
const uint DISAGREE8 = 288u;
const uint NEAR_BEST8 = 96u;
const uint SHAPE8 = 8u;
const uint QUAD_TRUST8 = 48u;

vec4 unpack_pixel(uint w) {
    if (pc.format == 2u) {
        return vec4(
            float(w & 1023u) / 1023.0,
            float((w >> 10u) & 1023u) / 1023.0,
            float((w >> 20u) & 1023u) / 1023.0,
            float(w >> 30u) / 3.0
        );
    }
    vec4 b = vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u)) / 255.0;
    return pc.format == 1u ? b.zyxw : b;
}

uint quantize(float c, float m) {
    precise float v = clamp(c, 0.0, 1.0) * m;
    precise float r = v + 0.5;
    return uint(floor(r));
}

uint pack_pixel(vec4 c) {
    if (pc.format == 2u) {
        return quantize(c.r, 1023.0) | (quantize(c.g, 1023.0) << 10u) | (quantize(c.b, 1023.0) << 20u)
            | (quantize(c.a, 3.0) << 30u);
    }
    vec4 o = pc.format == 1u ? c.zyxw : c;
    return quantize(o.x, 255.0) | (quantize(o.y, 255.0) << 8u) | (quantize(o.z, 255.0) << 16u)
        | (quantize(o.w, 255.0) << 24u);
}

vec4 load(bool previous, ivec2 q) {
    return unpack_pixel(previous ? imageLoad(prev_frame, q).r : imageLoad(cur_frame, q).r);
}

int luma_at(bool previous, ivec2 c) {
    ivec2 size = previous ? imageSize(prev_luma) : imageSize(cur_luma);
    c = clamp(c, ivec2(0), size - ivec2(1));
    float l = previous ? imageLoad(prev_luma, c).r : imageLoad(cur_luma, c).r;
    precise float q = clamp(l, 0.0, 1.0) * 255.0;
    precise float r = q + 0.5;
    return int(floor(r));
}

vec4 bilinear(bool previous, vec2 p) {
    vec2 c = clamp(p, vec2(0.0), vec2(float(pc.w - 1u), float(pc.h - 1u)));
    ivec2 p0 = ivec2(floor(c));
    ivec2 p1 = min(p0 + ivec2(1), ivec2(int(pc.w) - 1, int(pc.h) - 1));
    vec2 f = c - vec2(p0);
    if (f == vec2(0.0)) {
        return load(previous, p0);
    }
    vec4 a = load(previous, p0);
    vec4 b = load(previous, ivec2(p1.x, p0.y));
    vec4 c0 = load(previous, ivec2(p0.x, p1.y));
    vec4 d = load(previous, p1);
    return mix(mix(a, b, f.x), mix(c0, d, f.x), f.y);
}

vec2 prev_at(vec2 p, vec2 v) {
    precise vec2 s = pc.t * v;
    precise vec2 r = p - s;
    return r;
}

vec2 cur_at(vec2 p, vec2 v) {
    precise float u = 1.0 - pc.t;
    precise vec2 s = u * v;
    precise vec2 r = p + s;
    return r;
}

vec2 vector_at(ivec2 block) {
    return imageLoad(flow, block).xy * 2.0;
}

float size_of(vec2 v) {
    return abs(v.x) + abs(v.y);
}
shared int win_prev[6][11][11];
shared int win_cur[6][11][11];
shared uint group_disagree;
shared uint group_tile;
shared uint group_still;

uint shape12(int i, ivec2 ca, ivec2 cb) {
    int signed_sum = 0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            int weight = (dx == 0 && dy == 0) ? 4 : 1;
            signed_sum += weight * (win_prev[i][ca.y + dy][ca.x + dx] - win_cur[i][cb.y + dy][cb.x + dx]);
        }
    }
    uint shape = 0u;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            int weight = (dx == 0 && dy == 0) ? 4 : 1;
            int d = win_prev[i][ca.y + dy][ca.x + dx] - win_cur[i][cb.y + dy][cb.x + dx];
            shape += uint(weight) * uint(abs(12 * d - signed_sum));
        }
    }
    return shape;
}
uint window_cost(int i, vec2 pf, vec2 v, ivec2 base_p, ivec2 base_c) {
    ivec2 ca = clamp(ivec2(floor(prev_at(pf, v) / 2.0)) - base_p, ivec2(1), ivec2(9));
    ivec2 cb = clamp(ivec2(floor(cur_at(pf, v) / 2.0)) - base_c, ivec2(1), ivec2(9));
    uint cost = 0u;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            uint weight = (dx == 0 && dy == 0) ? 4u : 1u;
            cost += weight * uint(abs(win_prev[i][ca.y + dy][ca.x + dx] - win_cur[i][cb.y + dy][cb.x + dx]));
        }
    }
    return cost;
}

void choose(vec2 pf, vec2 cands[6], int n, ivec2 base_prev[6], ivec2 base_cur[6], out vec2 best, out uint best_cost, out int best_index) {
    uint costs[6];
    uint lowest = 0xFFFFFFFFu;
    int pick = 0;
    for (int i = 0; i < n; i++) {
        costs[i] = 0xFFFFFFFFu;
        if (lowest == 0u && size_of(cands[i]) >= size_of(cands[pick])) {
            continue;
        }
        ivec2 ca = clamp(ivec2(floor(prev_at(pf, cands[i]) / 2.0)) - base_prev[i], ivec2(1), ivec2(9));
        ivec2 cb = clamp(ivec2(floor(cur_at(pf, cands[i]) / 2.0)) - base_cur[i], ivec2(1), ivec2(9));
        uint cost = 0u;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                uint weight = (dx == 0 && dy == 0) ? 4u : 1u;
                cost += weight * uint(abs(win_prev[i][ca.y + dy][ca.x + dx] - win_cur[i][cb.y + dy][cb.x + dx]));
            }
        }
        costs[i] = cost;
        if (cost < lowest) {
            lowest = cost;
            pick = i;
        }
    }
    if (lowest <= DISAGREE8) {
        uint limit = min(lowest + NEAR_BEST8, DISAGREE8);
        for (int i = 0; i < n; i++) {
            if (costs[i] <= limit && size_of(cands[i]) < size_of(cands[pick])) {
                ivec2 ca = clamp(ivec2(floor(prev_at(pf, cands[i]) / 2.0)) - base_prev[i], ivec2(1), ivec2(9));
                ivec2 cb = clamp(ivec2(floor(cur_at(pf, cands[i]) / 2.0)) - base_cur[i], ivec2(1), ivec2(9));
                if (shape12(i, ca, cb) <= 12u * SHAPE8) {
                    pick = i;
                }
            }
        }
    }
    best = cands[pick];
    best_cost = costs[pick];
    best_index = pick;
}

bool in_frame(ivec2 p) {
    return p.x < int(pc.w) && p.y < int(pc.h);
}

void main() {
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 q = origin + 2 * l;
    if (pc.t == 0.0 || pc.t == 1.0) {
        for (int k = 0; k < 4; k++) {
            ivec2 p = q + ivec2(k & 1, k >> 1);
            if (in_frame(p)) {
                uint w = pc.t == 0.0 ? imageLoad(prev_frame, p).r : imageLoad(cur_frame, p).r;
                imageStore(dst, p, uvec4(w, 0u, 0u, 0u));
            }
        }
        return;
    }
    if (gl_LocalInvocationIndex == 0u) {
        group_disagree = 0u;
        group_tile = 0u;
        group_still = 0u;
    }
    ivec2 own = min(origin / BLOCK, ivec2(int(pc.flow_w) - 1, int(pc.flow_h) - 1));
    ivec2 offsets[5] = ivec2[5](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    vec2 cands[6];
    cands[0] = vec2(0.0);
    int n = 1;
    for (int i = 0; i < 5; i++) {
        ivec2 b = own + offsets[i];
        if (b.x < 0 || b.y < 0 || b.x >= int(pc.flow_w) || b.y >= int(pc.flow_h)) {
            continue;
        }
        vec2 v = vector_at(b);
        bool seen = false;
        for (int j = 0; j < n; j++) {
            seen = seen || cands[j] == v;
        }
        if (!seen) {
            cands[n] = v;
            n++;
        }
    }
    ivec2 base_prev[6];
    ivec2 base_cur[6];
    for (int i = 0; i < n; i++) {
        base_prev[i] = ivec2(floor(prev_at(vec2(origin), cands[i]) / 2.0)) - ivec2(1);
        base_cur[i] = ivec2(floor(cur_at(vec2(origin), cands[i]) / 2.0)) - ivec2(1);
        for (int idx = int(gl_LocalInvocationIndex); idx < 121; idx += 64) {
            ivec2 c = ivec2(idx % 11, idx / 11);
            win_prev[i][c.y][c.x] = luma_at(true, base_prev[i] + c);
            win_cur[i][c.y][c.x] = luma_at(false, base_cur[i] + c);
        }
    }
    barrier();
    if (in_frame(q)) {
        vec2 corner;
        uint corner_cost;
        int corner_index;
        choose(vec2(q), cands, n, base_prev, base_cur, corner, corner_cost, corner_index);
        vec2 last = vec2(float(pc.w - 1u), float(pc.h - 1u));
        uint disagree = 0u;
        uint tile = 0u;
        uint still = 0u;
        for (int k = 0; k < 4; k++) {
            ivec2 p = q + ivec2(k & 1, k >> 1);
            if (!in_frame(p)) {
                continue;
            }
            vec2 pp = vec2(p);
            vec2 best = corner;
            uint best_cost = corner_cost;
            if (k != 0) {
                uint own = corner_cost <= QUAD_TRUST8 ? window_cost(corner_index, pp, corner, base_prev[corner_index], base_cur[corner_index]) : 0xFFFFFFFFu;
                if (own <= DISAGREE8) {
                    best_cost = own;
                } else {
                    int ignored;
                    choose(pp, cands, n, base_prev, base_cur, best, best_cost, ignored);
                }
            }
            vec4 a = bilinear(true, prev_at(pp, best));
            vec4 b = bilinear(false, cur_at(pp, best));
            vec3 c = best_cost > DISAGREE8 ? (pc.t >= 0.5 ? b.rgb : a.rgb) : a.rgb * (1.0 - pc.t) + b.rgb * pc.t;
            imageStore(dst, p, uvec4(pack_pixel(vec4(c, 1.0)), 0u, 0u, 0u));
            if (best_cost > DISAGREE8) {
                disagree++;
                bool edge = false;
                for (int i = 1; i < n; i++) {
                    vec2 sa = prev_at(pp, cands[i]);
                    vec2 sb = cur_at(pp, cands[i]);
                    bool inside_a = all(greaterThanEqual(sa, vec2(0.0))) && all(lessThanEqual(sa, last));
                    bool inside_b = all(greaterThanEqual(sb, vec2(0.0))) && all(lessThanEqual(sb, last));
                    edge = edge || !(inside_a && inside_b);
                }
                if (!edge) {
                    tile++;
                }
            }
            if (best_cost == 0u && best == vec2(0.0)) {
                still++;
            }
        }
        if (disagree > 0u) {
            atomicAdd(group_disagree, disagree);
        }
        if (tile > 0u) {
            atomicAdd(group_tile, tile);
        }
        if (still > 0u) {
            atomicAdd(group_still, still);
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        if (group_disagree > 0u) {
            imageAtomicAdd(counters, ivec2(0, int(pc.row)), group_disagree);
        }
        if (group_tile > 0u) {
            int tiles_h = int((pc.h + 15u) / 16u);
            imageAtomicAdd(tiles, ivec2(origin.x / 16, origin.y / 16 + int(pc.row) * tiles_h), group_tile);
        }
        if (group_still > 0u) {
            imageAtomicAdd(counters, ivec2(1, int(pc.row)), group_still);
        }
    }
}
