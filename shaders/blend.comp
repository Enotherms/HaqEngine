#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D a;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D b;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    uint w;
    uint h;
    float t;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.w || p.y >= pc.h) {
        return;
    }
    imageStore(dst, ivec2(p), mix(imageLoad(a, ivec2(p)), imageLoad(b, ivec2(p)), pc.t));
}
