#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32f) uniform readonly image2D prev_luma;
layout(set = 0, binding = 1, r32f) uniform readonly image2D cur_luma;
layout(set = 0, binding = 2, rg32f) uniform readonly image2D coarse_flow;
layout(set = 0, binding = 3, rg32f) uniform writeonly image2D out_flow;

layout(push_constant) uniform Push {
    uint w;
    uint h;
    uint coarse_w;
    uint coarse_h;
    int radius;
    uint use_coarse;
} pc;

const int BLOCK = 8;
const int MAX_RADIUS = 4;
const int MAX_WINDOW = BLOCK + 2 * MAX_RADIUS;
const int MAX_OFFSETS = (2 * MAX_RADIUS + 1) * (2 * MAX_RADIUS + 1);
const float QUANT = 1023.0;

shared int prev_q[64];
shared int reduce[64];
shared int window_q[MAX_WINDOW * MAX_WINDOW];
shared int sads[MAX_OFFSETS];

int quantize(float l) {
    precise float q = clamp(l, 0.0, 1.0) * QUANT;
    precise float r = q + 0.5;
    return int(floor(r));
}

ivec2 scaled(ivec2 c) {
    vec2 v = imageLoad(coarse_flow, c).rg;
    return ivec2(round(2.0 * v));
}

void main() {
    ivec2 b = ivec2(gl_WorkGroupID.xy);
    ivec2 lp = ivec2(gl_LocalInvocationID.xy);
    int tid = int(gl_LocalInvocationIndex);
    ivec2 q = b * BLOCK + lp;
    ivec2 limit = ivec2(int(pc.w) - 1, int(pc.h) - 1);
    bool valid = q.x < int(pc.w) && q.y < int(pc.h);

    prev_q[tid] = valid ? quantize(imageLoad(prev_luma, q).r) : 0;
    barrier();

    ivec2 candidates[10];
    int n = 0;
    if (pc.use_coarse != 0u) {
        ivec2 c = ivec2(min(uint(b.x) / 2u, pc.coarse_w - 1u), min(uint(b.y) / 2u, pc.coarse_h - 1u));
        candidates[n++] = scaled(c);
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                ivec2 nb = c + ivec2(dx, dy);
                bool inside = nb.x >= 0 && nb.y >= 0 && nb.x < int(pc.coarse_w) && nb.y < int(pc.coarse_h);
                if ((dx != 0 || dy != 0) && inside) {
                    candidates[n++] = scaled(nb);
                }
            }
        }
    }
    candidates[n++] = ivec2(0);

    ivec2 pred = candidates[0];
    int pred_sad = 0x7fffffff;
    for (int i = 0; i < n; i++) {
        ivec2 c = clamp(q + candidates[i], ivec2(0), limit);
        reduce[tid] = valid ? abs(prev_q[tid] - quantize(imageLoad(cur_luma, c).r)) : 0;
        barrier();
        for (int s = 32; s > 0; s >>= 1) {
            if (tid < s) {
                reduce[tid] += reduce[tid + s];
            }
            barrier();
        }
        int sad = reduce[0];
        barrier();
        if (i == 0 || sad < pred_sad) {
            pred = candidates[i];
            pred_sad = sad;
        }
    }

    int r = min(pc.radius, MAX_RADIUS);
    int size = BLOCK + 2 * r;
    ivec2 origin = b * BLOCK + pred - ivec2(r);
    for (int i = tid; i < size * size; i += 64) {
        ivec2 c = clamp(origin + ivec2(i % size, i / size), ivec2(0), limit);
        window_q[i] = quantize(imageLoad(cur_luma, c).r);
    }
    barrier();

    int span = 2 * r + 1;
    int count = span * span;
    ivec2 block_origin = b * BLOCK;
    for (int k = tid; k < count; k += 64) {
        int dx = k % span - r;
        int dy = k / span - r;
        int sad = 0;
        for (int py = 0; py < BLOCK; py++) {
            for (int px = 0; px < BLOCK; px++) {
                if (block_origin.x + px < int(pc.w) && block_origin.y + py < int(pc.h)) {
                    int cur_value = window_q[(py + dy + r) * size + (px + dx + r)];
                    sad += abs(prev_q[py * BLOCK + px] - cur_value);
                }
            }
        }
        sads[k] = sad;
    }
    barrier();

    if (tid == 0) {
        int best_sad = 0x7fffffff;
        int best_d2 = 0x7fffffff;
        ivec2 best = pred;
        for (int k = 0; k < count; k++) {
            int dx = k % span - r;
            int dy = k / span - r;
            int d2 = dx * dx + dy * dy;
            if (sads[k] < best_sad || (sads[k] == best_sad && d2 < best_d2)) {
                best_sad = sads[k];
                best_d2 = d2;
                best = pred + ivec2(dx, dy);
            }
        }
        imageStore(out_flow, b, vec4(vec2(best), 0.0, 0.0));
    }
}
